# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
# When you push to GitHub, add these same names under
# Settings → Secrets and variables → Actions → New repository secret.
#
# Behaviour (cadence, timezone, which channels are on) lives in config.yml.
# Only secrets and things that identify you belong here.

# ---- required ----------------------------------------------------------

# The entire service-account key file, pasted as one value (keep the braces).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# The long id in your sheet's URL, between /d/ and /edit.
SHEET_ID=1AbCdEf...

# ---- Discord (channels.discord.enabled) --------------------------------

# Channel Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Your Discord user id, so nags @-mention you and your phone actually buzzes.
# Enable Developer Mode, then right-click yourself → Copy User ID.
DISCORD_USER_ID=

# ---- Email (channels.email.enabled) ------------------------------------

# The Gmail account the nags are sent *from*.
GMAIL_ADDRESS=you@gmail.com

# A Google App Password — NOT your normal password. Requires 2-Step
# Verification: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Where the nags go. Comma-separate for more than one.
EMAIL_TO=you@gmail.com

# Optional: use a non-Gmail SMTP server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ---- SMS (channels.sms.enabled) ----------------------------------------

# Your mobile number. The free carrier gateway needs a 10-digit North
# American number; Twilio takes E.164 (+15551234567).
SMS_TO=+15551234567

# Only for channels.sms.provider: twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
